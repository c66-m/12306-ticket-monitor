# ===== 隐私与运行时数据（禁止上传）=====
# 真实配置（含邮箱、SMTP 授权码、乘车人等隐私）
config.json
# 登录会话 Cookie
session_cookies.json
# probe 诊断脚本的独立 Cookie 文件（含会话，不上传）
probe_cookies.json
# Playwright 持久化浏览器 profile（含登录态与设备指纹）
.browser_profile/
.browser_state.json
# 运行时状态与历史（含乘车人、订单信息）
state.json
order_history.json
passengers.json
# Fernet 对称密钥文件（非 Windows 下 passengers.py 写入，明文，0o600）
.passengers_key
# launcher 的本地配置（含乘车人、常用路线等个人数据）
launcher_config.json
# 抢票任务数据（含乘车人、行程等个人数据）
grab_tasks.json
# 日志
logs/

# ===== 数据目录 data/（2026-10-18 起代码与数据分离，详见 tools/migrate_data_dir.py）=====
# 运行时数据（含隐私 / 可再生）：一律忽略。
# 注意：data/stations_*.json、data/station_*.json 是随代码分发的静态资产，故意不忽略。
data/orders.json
data/state.json
data/order_history.json
data/passengers.json
data/grab_tasks.json
data/session_cookies.json
data/.browser_state.json
# 问题台账（界面「问题日志」页数据源，含本机报错现场，不入库）
data/problem_log.jsonl
data/problem_log.jsonl.trim
# data/ 下的一次性迁移备份（含全部隐私数据）
data_migration_backup/
# SQLite 双写镜像库（P0 起，data/app.db + WAL 日志，可再生产物不入库）
data/app.db
data/app.db-wal
data/app.db-shm

# ===== 开发调试产物（含个人测试数据，不上传）=====
_*
# 例外：Python 包的 __init__.py 不是调试产物——`_*` 会误伤下划线开头的包入口
# （2026-10-18 legacy/ 包初始化文件被静默忽略，clone 后 import 失败才发现）。
!__init__.py
!**/__init__.py
*.png
# 例外：web-dashboard 的设计稿预览图是交付物本身（DESIGN.md 引用它们说明视觉方向），入库
!web-dashboard/preview-*.png
.browser_profile.lock
# runs/ 下的 fofa 调试产物（含查询结果），只留脚本本身
runs/*.jsonl
# 别在这里写 "%SystemDrive%/"：带引号 git 不展开环境变量，反而会被工具当路径建出真目录

# ===== Python 缓存 =====
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# ===== 编辑器/系统 =====
.vscode/
.idea/
Thumbs.db
desktop.ini
*.log

# ===== Node 依赖 =====
# electron/ 的运行时依赖（含已下载的 electron 二进制），启动脚本直接用本地副本，不进仓库
node_modules/

# ===== 本地临时文件 =====
# 原子写的临时名带 pid 后缀（config.json.tmp123 / state.json.guisave456 等）
*.tmp
*.tmp*
*.guisave*
*.launcher
*.lock
state.json.bad*
orders.json
config.json.pbak*
