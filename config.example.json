{
  "_说明": "本文件为配置模板。复制为 config.json 后按需修改，切勿把真实邮箱/授权码提交到仓库。密码/验证码一律不处理。",
  "auto_start_engine": true,
  "poll_interval_seconds": 7,
  "min_interval_seconds": 7,
  "order_retry_times": 3,
  "order_retry_delay_seconds": 2,
  "order_retry_cooldown_seconds": 7,
  "adaptive": {
    "enabled": false,
    "peak_hours": [
      6,
      23
    ],
    "peak_multiplier": 1.0,
    "offpeak_multiplier": 1.6,
    "rush_within_hours": 24,
    "rush_multiplier": 0.75
  },
  "session_cookies_file": "session_cookies.json",
  "state_file": "state.json",
  "history_file": "order_history.json",
  "passengers_file": "passengers.json",
  "log_dir": "logs",
  "http_timeout": 15,
  "notify": {
    "email": {
      "enabled": false,
      "smtp_host": "smtp.qq.com",
      "smtp_port": 465,
      "username": "your_account@qq.com",
      "password": "your_smtp_auth_code",
      "from": "your_account@qq.com",
      "to": [
        "your_account@qq.com"
      ]
    }
  },
  "tasks": [],
  "order_mode": "browser",
  "browser_headless": false,
  "keep_pay_page": true,
  "pay_page_keep_seconds": 300,
  "order_flow_mode": true,
  "order_flow": {
    "read_poll_seconds": 0.5,
    "page_wait_seconds": 30,
    "retry_open_times": 1,
    "lock_confirm_seconds": 1.5
  },
  "task_defaults": {
    "auto_order": true,
    "stop_after_order": true,
    "notify": true,
    "start_now": true
  }
}
